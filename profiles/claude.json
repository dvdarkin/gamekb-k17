{
  "lighting": { "mode": "per-key", "brightness": 4 },
  "default_color": [0, 0, 0],
  "keys": {
    "Q":       { "macro": "/model fable{Enter}", "label": "fable", "color": [255, 190, 0] },
    "W":       { "macro": "/model opus{Enter}", "label": "opus", "color": [170, 40, 255] },
    "E":       { "macro": "/model sonnet{Enter}", "label": "sonnet", "color": [30, 100, 255] },
    "R":       { "macro": "/effort{Enter}", "label": "effort", "color": [190, 190, 210] },
    "Mute":    { "color": [40, 40, 50] },
    "Tab":     { "macro": "/clear", "label": "/clear", "color": [255, 0, 0] },
    "A":       { "key": "Escape", "label": "esc", "color": [255, 90, 0] },
    "S":       { "shortcut": "Ctrl+O", "label": "transcript", "color": [0, 200, 200] },
    "D":       { "macro": "/mcp{Enter}", "label": "/mcp", "color": [0, 220, 140] },
    "F":       { "macro": "/context{Enter}", "label": "/context", "color": [0, 150, 255] },
    "Vol+":    { "color": [40, 40, 50] },
    "LShift":  { "macro": "/compact ", "label": "/compact", "color": [255, 30, 0] },
    "Z":       { "shortcut": "Ctrl+C", "label": "copy", "color": [200, 200, 220] },
    "X":       { "shortcut": "Ctrl+V", "label": "paste", "color": [200, 200, 220] },
    "C":       { "shortcut": "Ctrl+X", "label": "cut", "color": [200, 200, 220] },
    "V":       { "key": "Enter", "label": "enter", "color": [0, 255, 60] },
    "Vol-":    { "color": [40, 40, 50] },
    "Bright+": { "shortcut": "Shift+Tab", "label": "mode", "color": [255, 0, 150] },
    "Bright-": { "shortcut": "Shift+Tab", "label": "mode", "color": [255, 0, 255] },
    "Space":   { "macro": "yes{Enter}", "label": "yes", "color": [0, 255, 0] },
    "FN":      { "macro": "continue{Enter}", "label": "continue", "color": [130, 255, 0] }
  }
}
